# ===========================================
# ESGIO - Configuration des notifications
# ===========================================
# Copiez ce fichier en .env.local et remplissez les valeurs

# --- OPTION 1: Email via Resend (recommandé) ---
# Créez un compte gratuit sur https://resend.com
# Puis récupérez votre API key dans Settings > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# L'adresse email où vous recevrez les demandes de démo
CONTACT_NOTIFY_EMAIL=votreadresse@email.com

# --- OPTION 2: Webhook Discord (notifications instantanées) ---
# Dans Discord: Paramètres du serveur > Intégrations > Webhooks > Nouveau webhook
# Copiez l'URL du webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# --- OPTION 3: Webhook Slack (notifications instantanées) ---
# Dans Slack: Apps > Incoming Webhooks > Add to Slack
# Copiez l'URL du webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx/xxxxx/xxxxx
